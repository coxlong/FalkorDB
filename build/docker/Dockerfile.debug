ARG BASE_IMAGE=falkordb/falkordb-compiler

ARG TARGETPLATFORM=linux/amd64

ARG BROWSER_TAG=latest

FROM $BASE_IMAGE AS compiler

FROM falkordb/falkordb-browser:$BROWSER_TAG AS browser


FROM node:24-bookworm-slim AS node

FROM redis:8.6.3

# --- DEBUG variant: keep gdb + core dump support ---

ENV FALKORDB_HOME=/var/lib/falkordb

ENV FALKORDB_DATA_PATH=${FALKORDB_HOME}/data

ENV FALKORDB_BIN_PATH=${FALKORDB_HOME}/bin

ENV FALKORDB_IMPORT_PATH=${FALKORDB_HOME}/import

ENV FALKORDB_TLS_PATH=${FALKORDB_HOME}/tls

ENV FALKORDB_BROWSER_PATH=${FALKORDB_HOME}/browser

RUN mkdir -p /FalkorDB/build/docker && \
    mkdir -p /FalkorDB/bin/src && \
    mkdir -p /data

RUN ln -s ${FALKORDB_BIN_PATH} /FalkorDB/build/docker && \
    ln -s ${FALKORDB_BIN_PATH} /FalkorDB/bin/src && \
    ln -s ${FALKORDB_DATA_PATH} /data

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgomp1 ca-certificates bash gosu uidmap gdb && \
    ln -sf "$(command -v gosu)" /usr/local/bin/su-exec && \
    groupadd -g 1001 nodejs && \
    useradd -r -u 1001 -g nodejs nextjs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Enable coredump in container
RUN echo "kernel.core_pattern=/tmp/core.%e.%p" > /etc/sysctl.d/99-core.conf 2>/dev/null || true
RUN echo "* soft core unlimited" >> /etc/security/limits.conf && \
    echo "* hard core unlimited" >> /etc/security/limits.conf

COPY --from=node /usr/local/bin/node /usr/local/bin/

WORKDIR ${FALKORDB_HOME}

COPY ./build/docker/run.sh ${FALKORDB_BIN_PATH}/run.sh
COPY ./build/docker/gen-certs.sh ${FALKORDB_BIN_PATH}/gen-certs.sh

COPY --from=compiler /FalkorDB/bin/linux*/falkordb.so ${FALKORDB_BIN_PATH}/falkordb.so

# cppjieba Chinese tokenizer dictionaries
COPY --from=compiler /FalkorDB/deps/RediSearch/deps/cppjieba/dict/ ${FALKORDB_BIN_PATH}/jieba_dict/
ENV JIEBA_DICT_DIR=${FALKORDB_BIN_PATH}/jieba_dict

COPY --from=browser /app ${FALKORDB_BROWSER_PATH}
COPY --from=browser /usr/local/bin/docker-entrypoint.sh ${FALKORDB_BROWSER_PATH}

RUN chown -R 1001:1001 ${FALKORDB_BROWSER_PATH} && \
    mkdir -p /app/.data && \
    chown -R 1001:1001 /app/.data

ENV ARCH=${TARGETPLATFORM}
ENV TLS=0
ENV BROWSER=0

EXPOSE 6379/tcp

ENV FALKORDB_ARGS="MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000"

# Run directly (not via run.sh) with ulimit for core dumps
CMD ["sh", "-c", "ulimit -c unlimited && exec redis-server --protected-mode no --loadmodule /var/lib/falkordb/bin/falkordb.so MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000"]
